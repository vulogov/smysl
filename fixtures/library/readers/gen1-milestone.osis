<?xml version="1.0" encoding="UTF-8"?>
<osis>
  <osisText osisIDWork="KJV1769" xml:lang="en">
    <header>
      <work osisWork="KJV1769">
        <title>The King James Version, 1769</title>
      </work>
    </header>
    <div type="book" osisID="Gen">
      <chapter sID="Gen.1" osisID="Gen.1"/>
      <verse sID="Gen.1.1" osisID="Gen.1.1"/>In the beginning God created the heaven and the earth.<verse eID="Gen.1.1"/>
      <verse sID="Gen.1.2" osisID="Gen.1.2"/>And the earth was without form, and void; and darkness was upon the face of the deep. And the Spirit of God moved upon the face of the waters.<verse eID="Gen.1.2"/>
      <verse sID="Gen.1.3" osisID="Gen.1.3"/>And God said, Let there be light: and there was light.<verse eID="Gen.1.3"/>
      <verse sID="Gen.1.4" osisID="Gen.1.4"/>And God saw the light, that it was good: and God divided the light from the darkness.<verse eID="Gen.1.4"/>
      <verse sID="Gen.1.5" osisID="Gen.1.5"/>And God called the light Day, and the darkness he called Night. And the evening and the morning were the first day.<verse eID="Gen.1.5"/>
      <chapter eID="Gen.1"/>
    </div>
  </osisText>
</osis>
