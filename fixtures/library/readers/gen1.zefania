  <BIBLEBOOK bnumber="1" bname="1. Mose">
    <CHAPTER cnumber="1">
      <VERS vnumber="1">Am Anfang schuf Gott Himmel und Erde.</VERS>
      <VERS vnumber="2">Und die Erde war w&#252;st und leer, und es war finster auf der Tiefe; und der Geist Gottes schwebte auf dem Wasser.</VERS>
      <VERS vnumber="3">Und Gott sprach: Es werde Licht! und es ward Licht.</VERS>
    </CHAPTER>
  </BIBLEBOOK>
